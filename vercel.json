{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "permanent": true
    },
    {
      "source": "/experiencias/:path*",
      "destination": "/revista/:path*",
      "permanent": true
    },
    {
      "source": "/mis-planes",
      "destination": "/revista",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/planes",
      "destination": "/__removed__/planes"
    },
    {
      "source": "/planes/:path*",
      "destination": "/__removed__/planes"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/robots.txt"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/",
      "destination": "/web-next/"
    },
    {
      "source": "/evento/:slug",
      "destination": "/web-next/evento/:slug"
    },
    {
      "source": "/revista/:city/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/revista/:city",
      "destination": "/index.html"
    },
    {
      "source": "/experiencias/:city/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/experiencias/:city",
      "destination": "/index.html"
    },
    {
      "source": "/:vite_route(favoritos|cuenta|lealtad|wallet|mis-planes|revista|experiencias|explorar|eventos|mapa|precios|admin|manage|stats|itinerarios|about|privacy|terms|lugar|evento)",
      "destination": "/index.html"
    },
    {
      "source": "/:vite_route(favoritos|cuenta|lealtad|wallet|mis-planes|revista|experiencias|explorar|eventos|mapa|precios|admin|manage|stats|itinerarios|about|privacy|terms|lugar|evento)/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/:city",
      "destination": "/web-next/:city"
    },
    {
      "source": "/:country([a-z]{2})/:city",
      "destination": "/web-next/:city"
    },
    {
      "source": "/:city/c/:category(restaurantes|cafeterias|cafe|cafeteria|salud|belleza|fitness|gimnasios|compras|tiendas|tech|ocio|hoteles|hospedaje|educacion|servicios|bares|antros-y-bares)",
      "destination": "/web-next/:city/c/:category"
    },
    {
      "source": "/:city/:slug",
      "destination": "/web-next/:city/:slug"
    },
    {
      "source": "/:country([a-z]{2})/:city/:slug",
      "destination": "/web-next/:city/:slug"
    },
    {
      "source": "/:city/:slug/menu",
      "destination": "/web-next/:city/:slug/menu"
    },
    {
      "source": "/:country([a-z]{2})/:city/:slug/menu",
      "destination": "/web-next/:city/:slug/menu"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        }
      ]
    }
  ]
}