{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/robots.txt"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|WhatsApp|Twitterbot|LinkedInBot|Googlebot|bingbot|TelegramBot|Applebot|Discordbot|Slackbot|vkShare|Pinterest|w3c_validator|curl|python-requests|Discord|Skype|Viber).*|.*(bot|Bot|spider|Spider|crawler|Crawler|whatsapp|WhatsApp|Telegram|Discord).*"
        }
      ],
      "destination": "/web-next/"
    },
    {
      "source": "/evento/:slug",
      "destination": "/web-next/evento/:slug"
    },
    {
      "source": "/experiencias/:city/:slug",
      "destination": "/web-next/experiencias/:city/:slug"
    },
    {
      "source": "/experiencias/:city",
      "destination": "/web-next/experiencias/:city"
    },
    {
      "source": "/:city",
      "destination": "/web-next/:city"
    },
    {
      "source": "/:country([a-z]{2})/:city",
      "destination": "/web-next/:city"
    },
    {
      "source": "/:city/:category(restaurantes|cafeterias|cafe|cafeteria|salud|belleza|fitness|gimnasios|compras|tiendas|tech|ocio|hoteles|hospedaje|educacion|servicios|bares|antros-y-bares)",
      "destination": "/web-next/:city/:category"
    },
    {
      "source": "/:city/:slug",
      "destination": "/web-next/:city/:slug"
    },
    {
      "source": "/:country([a-z]{2})/:city/:slug",
      "destination": "/web-next/:city/:slug"
    },
    {
      "source": "/:city/:slug/menu",
      "destination": "/web-next/:city/:slug/menu"
    },
    {
      "source": "/:country([a-z]{2})/:city/:slug/menu",
      "destination": "/web-next/:city/:slug/menu"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
