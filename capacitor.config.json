{
  "appId": "mx.citymap.app",
  "appName": "CityMap",
  "webDir": "dist",
  "server": {
    "url": "https://citymap.mx",
    "cleartext": false,
    "allowNavigation": [
      "citymap.mx",
      "www.citymap.mx",
      "citymap.world",
      "www.citymap.world"
    ]
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "SystemBars": {
      "insetsHandling": "disable",
      "style": "LIGHT",
      "hidden": false
    },
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": false,
        "apple": false,
        "twitter": false
      }
    }
  }
}
